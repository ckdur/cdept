# Replays the inv-library tutorial: every click is where the guide points.
guide expect_step start
guide press dialog.guide.start
guide wait manager
screenshot @SCRATCH@/01-started.png
guide expect_pointing menu.tools
guide click
guide expect_pointing menu.tools.library_manager
guide click
guide expect_step new-library
guide expect_pointing manager.new_library
guide click
guide expect_step name-library
wait 0.6
guide click
text work
screenshot @SCRATCH@/02-name-library.png
guide press dialog.confirm
# A new library is selected: "select-library" is passed at once.
guide expect_step new-cell
guide expect_pointing manager.new_cell
guide click
guide expect_step name-cell
wait 0.6
guide click
text inv
guide press dialog.confirm
guide expect_step open
wait 0.6
screenshot @SCRATCH@/03-open.png
open_view work inv schematic
guide expect_step done
wait_frame
wait 0.5
screenshot @SCRATCH@/04-done.png
guide continue
guide expect_step finished
quit
