# Replays the ota-schematic tutorial. The devices and wires are put down with xschem's
# commands at the places of the reference drawing, stage by stage, so that each circuit
# check has to pass in turn; the picker's marks, saving and Make symbol are used by
# clicks. Generated once from the reference schematic.
guide expect_step start
wait 1.5
guide press dialog.guide.start
guide wait open
wait 0.5
guide expect_pointing tree:work
guide click
wait 0.6
guide expect_pointing tree:work/ota5t
guide click
wait 0.6
guide expect_pointing tree:work/ota5t/schematic
open_view work ota5t schematic
guide expect_step circuit
wait_frame
wait 0.8
screenshot @SCRATCH@/01-circuit.png
guide continue
guide expect_step bias
move 400 300
key Insert
wait 0.8
guide expect_pointing xschem.picker.library:sg13g2_pr
guide click
wait 0.6
wait 0.5
picker_cancel
wait 0.5
tcl xschem instance sg13g2_pr/sg13_lv_pmos.sym -20 -220 0 0 {name=M5 l=1u w=32u ng=4 m=1 model=sg13_lv_pmos spiceprefix=X}
tcl xschem instance sg13g2_pr/sg13_lv_pmos.sym -200 -220 0 1 {name=M6 l=1u w=32u ng=4 m=1 model=sg13_lv_pmos spiceprefix=X}
tcl xschem instance ipin.sym -180 -140 1 0 {name=p3 lab=ibias}
tcl xschem instance iopin.sym 0 -290 3 0 {name=p5 lab=vdd}
tcl xschem instance lab_pin.sym 0 -220 0 0 {name=l1 sig_type=std_logic lab=vdd}
tcl xschem instance lab_pin.sym -220 -220 2 0 {name=l2 sig_type=std_logic lab=vdd}
tcl xschem wire -220 -250 0 -250
tcl xschem wire 0 -290 0 -250
tcl xschem wire -220 -190 -220 -170
tcl xschem wire -220 -170 -180 -170
tcl xschem wire -180 -170 -180 -220
tcl xschem wire -180 -220 -40 -220
tcl xschem wire -180 -140 -180 -170
tcl xschem redraw
guide wait pair
tcl xschem zoom_full
wait 1.0
screenshot @SCRATCH@/02-bias.png
tcl xschem instance sg13g2_pr/sg13_lv_pmos.sym -100 -100 0 0 {name=M1 l=0.5u w=30u ng=4 m=1 model=sg13_lv_pmos spiceprefix=X}
tcl xschem instance sg13g2_pr/sg13_lv_pmos.sym 100 -100 0 1 {name=M2 l=0.5u w=30u ng=4 m=1 model=sg13_lv_pmos spiceprefix=X}
tcl xschem instance ipin.sym -300 -100 0 0 {name=p1 lab=inp}
tcl xschem instance ipin.sym -300 -60 0 0 {name=p2 lab=inn}
tcl xschem instance opin.sym 180 -20 0 0 {name=p4 lab=out}
tcl xschem instance lab_pin.sym -80 -100 0 0 {name=l3 sig_type=std_logic lab=tail}
tcl xschem instance lab_pin.sym 80 -100 2 0 {name=l4 sig_type=std_logic lab=tail}
tcl xschem instance lab_pin.sym -120 -100 2 0 {name=l7 sig_type=std_logic lab=inp}
tcl xschem instance lab_pin.sym 120 -100 0 0 {name=l8 sig_type=std_logic lab=inn}
tcl xschem instance lab_pin.sym 0 -130 0 0 {name=l10 sig_type=std_logic lab=tail}
tcl xschem wire 0 -190 0 -130
tcl xschem wire -80 -130 80 -130
tcl xschem wire 80 -70 80 -20
tcl xschem wire 120 20 120 -20
tcl xschem wire 80 -20 120 -20
tcl xschem wire 120 -20 180 -20
tcl xschem redraw
guide wait mirror
tcl xschem zoom_full
wait 1.2
guide expect_check ota no place M3
screenshot @SCRATCH@/03-pair.png
tcl xschem instance sg13g2_pr/sg13_lv_nmos.sym -100 50 0 1 {name=M3 l=4u w=2u ng=1 m=1 model=sg13_lv_nmos spiceprefix=X}
tcl xschem instance sg13g2_pr/sg13_lv_nmos.sym 100 50 0 0 {name=M4 l=4u w=2u ng=1 m=1 model=sg13_lv_nmos spiceprefix=X}
tcl xschem instance iopin.sym 0 120 1 0 {name=p6 lab=vss}
tcl xschem instance lab_pin.sym -120 50 2 0 {name=l5 sig_type=std_logic lab=vss}
tcl xschem instance lab_pin.sym 120 50 0 0 {name=l6 sig_type=std_logic lab=vss}
tcl xschem instance lab_pin.sym -120 20 2 0 {name=l9 sig_type=std_logic lab=x}
tcl xschem wire -80 -70 -80 50
tcl xschem wire -80 50 80 50
tcl xschem wire -120 20 -80 20
tcl xschem wire -120 80 120 80
tcl xschem wire 0 80 0 120
tcl xschem redraw
guide wait save
tcl xschem zoom_full
wait 1.2
screenshot @SCRATCH@/04-complete.png
move 300 200
key s ctrl
wait 1.0
guide expect_pointing xschem.button:Yes
guide click
wait 1.5
guide continue
guide expect_step symbol
guide expect_pointing xschem.menu:Symbol
guide click
wait 0.6
guide expect_pointing xschem.menu:Make symbol from schematic
guide click
wait 1.0
guide expect_pointing xschem.button:OK
screenshot @SCRATCH@/05-make-symbol.png
guide click
guide wait check-symbol
wait 0.8
guide expect_marked
wait 0.8
open_view work ota5t symbol
wait_frame
wait 1.0
screenshot @SCRATCH@/06-symbol.png
guide continue
guide expect_step done
wait 0.6
guide continue
guide expect_step finished
quit
