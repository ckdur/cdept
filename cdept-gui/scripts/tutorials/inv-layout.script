# Replays the inv-layout tutorial: every drawing step through the layout tab, clicking
# what the guide outlines. Corners are clicked zoomed in, as the tutorial says.
# Made with the help of a generator; edit by hand as needed.
guide expect_step start
wait 1
guide press dialog.guide.start
guide wait schematic
wait 2
guide expect_pointing tree:work
guide click
wait 0.4
guide expect_pointing tree:work/inv
guide click
wait 0.4
guide expect_pointing tree:work/inv/schematic
open_view work inv schematic
guide expect_step generate
wait_frame
wait 1
guide expect_pointing menu.cell
guide click
wait 0.4
guide expect_pointing menu.cell.layout
guide click
wait 0.4
guide wait look
wait 3
layout_call zoom {"what": "box", "box": [-1.5000, -1.5000, 2.5000, 7.0000]}
wait 0.2
screenshot @SCRATCH@/01-generated.png
guide continue
