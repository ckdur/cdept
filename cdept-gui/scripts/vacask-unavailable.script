# VACASK on a technology it cannot run (SYMBI-80, docs/VACASK.md 4b): the project of
# examples/ihp-inv is switched to sky130A (whose binned BSIM4 models VACASK's converter
# cannot read); the Simulation tab then shows VACASK disabled in the simulator combo, a
# testbench that names it has a problem line and cannot be run, and ngspice stays usable.
# VACASK itself need not be installed. Writes into the project: use a copy (run.sh does).
#
#   PDK_ROOT=/opt/ext/OpenPDKs CDEPT_XSCHEM=target/debug/cdept-xschem CDEPT_EXAMPLE=ihp-inv \
#     cdept-gui/scripts/run.sh cdept-gui/scripts/vacask-unavailable.script
#
# New `sim` verbs (views/simulation/avail.rs):
#   expect_simulator_disabled <name> [reason text]   the combo shows the entry disabled; the
#                                                    hover reason contains the text
#   expect_simulator_enabled <name>                  the entry can be picked
#   select_simulator <name>                          pick it in the combo (an error when disabled)
#   expect_select_refused <name>                     picking it is refused, the form keeps its simulator
#   expect_run_refused                               Run does not start (the reason is the problem)

panel Library Manager
wait 0.3

# The same project, now for sky130A: the technology snapshot is made again from the PDK.
shell sed -i 's/^technology = "ihp-sg13g2"/technology = "sky130A"/' cdept.toml
shell grep -q '^technology = "sky130A"' cdept.toml
reload_project
panel Technology
tech rescan files
tech expect_replace_question
tech answer yes
tech expect_rescanned
tech expect pdk.name sky130A
panel Library Manager
wait 0.3

# A testbench that already says simulator = "vacask": the problem line says why, the run
# is not offered.
open cells tb_inv vacask
sim expect_target cells/tb_inv/vacask
sim expect_problem VACASK is not available
sim expect_problem sky130A
sim expect_problem binned BSIM4
sim expect_run_refused
sim expect_state idle

# The combo: VACASK is disabled with the reason, the others are not, and it cannot be picked.
sim expect_simulator_disabled vacask sky130A
sim expect_simulator_enabled ngspice
sim expect_simulator_enabled xyce
sim expect_select_refused vacask
sim select_simulator ngspice
sim expect_no_problem
sim expect_select_refused vacask
sim select_simulator xyce
sim select_simulator ngspice
sim expect_no_problem
sim revert
log vacask-unavailable: ok
quit
